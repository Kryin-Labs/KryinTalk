# ──────────────────────────────────────────────
# ConnectHub — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=ConnectHub
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=connecthub
POSTGRES_PASSWORD=
POSTGRES_DB=connecthub

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── NATS ─────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_CLUSTER_NAME=connecthub

# ── Security ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Nginx / Domain ──────────────────────────
DOMAIN=connecthub.local

# Flutter compile-time values (pass with --dart-define, not Python .env loading)
AUTH_CALLBACK_ORIGIN=https://kryintalks.vercel.app
KRYINTALK_ADMIN_CONTACT_EMAIL=
