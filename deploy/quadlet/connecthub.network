# ──────────────────────────────────────────────
# ConnectHub — Podman Network (Quadlet)
# ──────────────────────────────────────────────
# Shared network for all ConnectHub containers.
# Place in: ~/.config/containers/systemd/connecthub.network
# ──────────────────────────────────────────────

[Network]
NetworkName=connecthub
Driver=bridge
Subnet=10.89.0.0/24
Gateway=10.89.0.1
